# ─────────────────────────────────────────────────────────────────────────────
# Genesis - all environment variables. Nothing secret is ever committed.
#
# Cloud Functions plain config  -> copy into functions/.env
# Cloud Functions secrets       -> firebase functions:secrets:set <NAME>
#                                  (emulator: functions/.secret.local)
# Frontend (Vite)               -> copy into frontend/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── functions/.env ──────────────────────────────────────────────────────────
# HighLevel marketplace app (Developer portal → your app → Auth)
HL_CLIENT_ID=
# Public URL of the deployed `api` function. The OAuth redirect URI registered in
# HighLevel must be exactly  ${API_BASE_URL}/oauth/callback
API_BASE_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/api
# Where the frontend is hosted (OAuth redirects back here; also the CORS allowlist)
APP_URL=https://YOUR_PROJECT_ID.web.app
# Claude model used for generation
LLM_MODEL=claude-opus-5-5
# Local development only - never enable in production
MOCK_LLM=false
MOCK_HL=false

# ── Secrets (Secret Manager) ────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# HL_CLIENT_SECRET=...
# GEMINI_API_KEY=...   (fallback when Claude is unavailable; a placeholder disables it)

# ── frontend/.env ───────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_APP_ID=
# Same value as API_BASE_URL above
VITE_API_BASE_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/api
# true = talk to the local Firebase emulators
VITE_USE_EMULATORS=false

# ── Gemini: automatic fallback when Claude is unavailable, or forced for testing ──
# The key is a secret like the others. LLM_PROVIDER=gemini forces Gemini for every request:
#   firebase functions:secrets:set GEMINI_API_KEY   (emulator: functions/.secret.local)
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.5-flash
